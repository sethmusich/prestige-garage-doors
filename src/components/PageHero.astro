---
// Inner-page banner: title, optional subtitle and background image, CTA buttons.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { SITE } from '../config';
import Button from './Button.astro';
import Icon from './Icon.astro';

interface Props {
  title: string;
  subtitle?: string;
  image?: ImageMetadata;
  eyebrow?: string;
  ctas?: boolean;
}
const { title, subtitle, image, eyebrow, ctas = true } = Astro.props;
const bg = image ? await getImage({ src: image, width: 1920, format: 'webp' }) : null;
---
<section class="page-hero" style={bg ? `--bg: url('${bg.src}')` : undefined}>
  <div class="container page-hero__inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <span class="page-hero__rule" aria-hidden="true"></span>
    {subtitle && <p class="page-hero__sub">{subtitle}</p>}
    {ctas && (
      <div class="btn-row">
        <Button href={SITE.phoneHref} variant="outline"><Icon name="phone" /> {SITE.phoneDisplay}</Button>
        <Button href={SITE.bookingUrl} external>Book Online</Button>
      </div>
    )}
  </div>
</section>
<hr class="gold-rule" />

<style>
  .page-hero {
    position: relative;
    padding-block: clamp(72px, 10vw, 132px);
    background:
      linear-gradient(100deg, rgba(5, 11, 28, 0.94) 0%, rgba(10, 17, 40, 0.8) 55%, rgba(10, 17, 40, 0.55) 100%),
      var(--bg, linear-gradient(135deg, var(--navy-800), var(--navy-950)));
    background-size: cover;
    background-position: center;
  }
  .page-hero__inner { max-width: 820px; margin-left: max(var(--gutter), calc((100% - var(--container)) / 2)); }
  .page-hero h1 { text-shadow: 0 2px 18px rgba(0,0,0,0.5); }
  .page-hero__rule { display: block; width: 140px; height: 3px; background: var(--gold); margin: 6px 0 22px; }
  .page-hero__sub { font-size: clamp(1.1rem, 2vw, 1.35rem); color: var(--text); max-width: 640px; margin-bottom: 28px; }
</style>
