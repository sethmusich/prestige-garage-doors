---
import { SITE, NAV } from '../config';
import { url } from '../lib/url';
import Icon from './Icon.astro';
import RatingBadge from './RatingBadge.astro';
import Logo from './Logo.astro';

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === url('/') : current.startsWith(url(href));
---
<header class="site-header" id="top">
  <div class="topbar">
    <div class="container topbar__inner">
      <RatingBadge compact />
      <p class="topbar__area">Serving the Denver Metro · {SITE.area}</p>
      <div class="topbar__social">
        <a href={SITE.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" /></a>
        {SITE.facebook && <a href={SITE.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" /></a>}
        {SITE.tiktok && <a href={SITE.tiktok} target="_blank" rel="noopener" aria-label="TikTok"><Icon name="tiktok" /></a>}
      </div>
    </div>
  </div>

  <div class="mainbar">
    <div class="container mainbar__inner">
      <a class="brand" href={url('/')} aria-label={`${SITE.name} home`}>
        <Logo />
      </a>

      <nav class="nav" id="site-nav" aria-label="Main">
        <ul class="nav__list">
          {NAV.map((item) => (
            <li class:list={['nav__item', { 'has-children': 'children' in item }]}>
              <a class:list={['nav__link', { active: isActive(item.href) }]} href={url(item.href)}>
                {item.label}
                {'children' in item && <Icon name="chevron" size={16} />}
              </a>
              {'children' in item && (
                <ul class="nav__sub">
                  {item.children.map((c) => (
                    <li><a href={url(c.href)}>{c.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
        <div class="nav__mobile-cta">
          <a class="nav__phone-lg" href={SITE.phoneHref}><Icon name="phone" /> {SITE.phoneDisplay}</a>
          <RatingBadge />
        </div>
      </nav>

      <div class="actions">
        <a class="phone" href={SITE.phoneHref}>
          <Icon name="phone" size={22} />
          <span class="phone__text">{SITE.phoneDisplay}</span>
        </a>
        <a class="book" href={url('/book/')}>Book Now</a>
        <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="Open menu">
          <span class="menu-toggle__open"><Icon name="menu" size={26} /></span>
          <span class="menu-toggle__close"><Icon name="close" size={26} /></span>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const header = document.querySelector('.site-header');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    header?.classList.toggle('menu-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; }
  .topbar { background: var(--navy-950); border-bottom: 1px solid rgba(255,255,255,0.06); font-size: 0.9rem; }
  .topbar__inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 6px; }
  .topbar__area { margin: 0; color: var(--text-muted); letter-spacing: 0.04em; }
  .topbar__social { display: flex; gap: 12px; }
  .topbar__social a { color: var(--gold); display: inline-flex; }
  .topbar__social a:hover { color: var(--white); }

  .mainbar { background: rgba(10, 17, 40, 0.97); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .mainbar__inner { display: flex; align-items: center; gap: 20px; min-height: var(--header-h); }
  .brand { display: inline-flex; align-items: center; text-decoration: none; flex: none; }

  .nav { margin-inline: auto; }
  .nav__list { list-style: none; display: flex; gap: 4px; margin: 0; padding: 0; }
  .nav__item { position: relative; }
  .nav__link {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 10px 10px; color: var(--white); text-decoration: none;
    font-weight: 700; font-size: 0.92rem; letter-spacing: 0.08em; text-transform: uppercase;
    border-bottom: 2px solid transparent;
  }
  .nav__link:hover, .nav__link.active { color: var(--gold-light); border-bottom-color: var(--gold); }
  .nav__sub {
    position: absolute; top: 100%; left: 0; min-width: 230px; list-style: none; margin: 0; padding: 8px;
    background: var(--navy-800); border: 1px solid var(--line); border-radius: 10px; box-shadow: var(--shadow);
    opacity: 0; visibility: hidden; transform: translateY(6px); transition: all 0.15s ease;
  }
  .has-children:hover .nav__sub, .has-children:focus-within .nav__sub { opacity: 1; visibility: visible; transform: none; }
  .nav__sub a { display: block; padding: 10px 12px; color: var(--white); text-decoration: none; border-radius: 6px; }
  .nav__sub a:hover { background: var(--navy-700); color: var(--gold-light); }
  .nav__mobile-cta { display: none; }

  .actions { display: flex; align-items: center; gap: 14px; flex: none; }
  .phone { display: inline-flex; align-items: center; gap: 8px; color: var(--white); text-decoration: none; font-weight: 700; font-size: 1.15rem; }
  .phone :global(svg) { color: var(--gold); }
  .phone:hover { color: var(--gold-light); }
  .book {
    display: inline-flex; align-items: center; min-height: 46px; padding: 0 1.4em;
    border-radius: var(--radius-pill); text-decoration: none; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    background: linear-gradient(180deg, var(--gold-light), var(--gold-bright) 45%, var(--gold-dark)); color: var(--navy-950);
  }
  .book:hover { color: var(--navy-950); filter: brightness(1.08); }
  .menu-toggle { display: none; background: none; border: 0; color: var(--white); padding: 6px; cursor: pointer; }
  .menu-toggle__close { display: none; }

  @media (max-width: 1180px) {
    .phone__text { display: none; }
    .phone { width: 46px; height: 46px; justify-content: center; border: 2px solid var(--gold); border-radius: 50%; }
  }

  @media (max-width: 1024px) {
    .topbar__area { display: none; }
    .menu-toggle { display: inline-flex; }
    .nav {
      position: fixed; inset: calc(var(--header-h) + 44px) 0 0 0; margin: 0;
      background: var(--navy-900); padding: 24px var(--gutter) 40px; overflow-y: auto;
      transform: translateX(100%); transition: transform 0.25s ease; visibility: hidden;
    }
    .menu-open .nav { transform: none; visibility: visible; }
    .menu-open .menu-toggle__open { display: none; }
    .menu-open .menu-toggle__close { display: inline-flex; }
    .nav__list { flex-direction: column; gap: 0; }
    .nav__link { font-size: 1.1rem; padding: 14px 4px; width: 100%; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .nav__link :global(svg) { display: none; }
    .nav__sub { position: static; opacity: 1; visibility: visible; transform: none; background: none; border: 0; box-shadow: none; padding: 0 0 8px 16px; }
    .nav__mobile-cta { display: grid; gap: 18px; margin-top: 28px; justify-items: start; }
    .nav__phone-lg { display: inline-flex; gap: 10px; align-items: center; font-size: 1.4rem; font-weight: 700; color: var(--white); text-decoration: none; }
    .nav__phone-lg :global(svg) { color: var(--gold); }
  }

  @media (max-width: 560px) {
    :root { --header-h: 70px; }
    .mainbar__inner { gap: 10px; }
    .actions { gap: 8px; margin-left: auto; }
    .book { padding: 0 1em; font-size: 0.9rem; min-height: 42px; }
    .phone { width: 42px; height: 42px; }
    .topbar__inner { justify-content: center; }
    .topbar__social { display: none; }
  }
</style>
