---
// sm: crest + text lockup (header). lg: full logo image (footer, dark backgrounds).
import { Image } from 'astro:assets';
import crest from '../assets/logo/crest.png';
import full from '../assets/logo/logo-full-light.png';
interface Props { size?: 'sm' | 'lg' }
const { size = 'sm' } = Astro.props;
---
{size === 'lg' ? (
  <Image src={full} alt="Prestige Garage Doors" width={220} class="logo-full" loading="lazy" />
) : (
  <span class="logo">
    <Image src={crest} alt="Prestige Garage Doors" height={58} width={Math.round(58 * crest.width / crest.height)} class="logo__crest" loading="eager" />
    <span class="logo__text" aria-hidden="true">
      <span class="logo__name">Prestige</span>
      <span class="logo__sub">Garage Doors</span>
    </span>
  </span>
)}

<style>
  .logo { display: inline-flex; align-items: center; gap: 12px; }
  .logo__crest { height: 58px; width: auto; }
  .logo__text { display: grid; line-height: 1; text-align: center; }
  .logo__name { font-family: var(--font-display); font-weight: 700; color: var(--white); font-size: 1.45rem; letter-spacing: 0.14em; }
  .logo__sub { font-family: var(--font-display); font-weight: 600; color: var(--gold); font-size: 0.66rem; letter-spacing: 0.22em; margin-top: 5px; padding-top: 4px; border-top: 1px solid var(--line); }
  .logo-full { width: 220px; height: auto; }
  @media (max-width: 560px) {
    .logo__crest { height: 46px; }
    .logo__name { font-size: 1.1rem; }
    .logo__sub { font-size: 0.55rem; }
  }
  @media (max-width: 380px) { .logo__text { display: none; } }
</style>
