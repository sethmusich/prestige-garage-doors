---
import { SITE } from '../config';
import { cities } from '../data/cities';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { url } from '../lib/url';
interface Props { compact?: boolean; headingAs?: 'h1' | 'h2' }
const { compact = false, headingAs: Tag = 'h2' } = Astro.props;
const shown = compact ? cities.slice(0, 12) : cities;
---
<section class="areas">
  <div class="container">
    <div class="areas__panel">
      <div class="areas__text">
        <Tag class="areas__h">Service Areas</Tag>
        <p class="areas__lead">Proudly serving the {SITE.region}, anywhere from {SITE.area}.</p>
        <ul class="areas__list">
          {shown.map((c) => <li><Icon name="pin" size={22} /> {c}, CO</li>)}
        </ul>
        {compact && <Button href={url('/service-areas/')} variant="outline">See all service areas</Button>}
      </div>
      <div class="areas__map">
        <iframe
          title="Map of the Denver Metro service area"
          src="https://www.google.com/maps?q=Denver+Metro,+Colorado&z=9&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .areas {
    padding-block: var(--section-y);
    background:
      linear-gradient(rgba(5,11,28,0.88), rgba(5,11,28,0.88)),
      repeating-linear-gradient(0deg, var(--navy-800) 0 38px, var(--navy-900) 38px 40px);
    border-top: 6px solid var(--gold);
  }
  .areas__panel {
    display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items: stretch;
    background: var(--navy-800); border: 2px solid var(--gold); border-radius: var(--radius);
    padding: clamp(24px, 4vw, 48px);
  }
  .areas__h { text-transform: uppercase; }
  .areas__lead { color: var(--text-muted); font-size: 1.1rem; }
  .areas__list { list-style: none; padding: 0; margin: 0 0 28px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px 20px; }
  .areas__list li { display: flex; align-items: center; gap: 10px; color: var(--gold-light); font-size: 1.05rem; }
  .areas__list :global(svg) { color: var(--gold); flex: none; }
  .areas__map { min-height: 360px; border-radius: 10px; overflow: hidden; border: 1px solid var(--line); }
  .areas__map iframe { width: 100%; height: 100%; min-height: 360px; border: 0; display: block; filter: saturate(0.85); }
  @media (max-width: 860px) { .areas__panel { grid-template-columns: 1fr; } }
  @media (max-width: 380px) { .areas__list { grid-template-columns: 1fr; } }
</style>
