---
// Scroll-snap slideshow. Swipe/scroll works without JS; JS adds dots and auto-advance.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { images: { src: ImageMetadata; alt: string }[]; id?: string }
const { images, id = 'slides' } = Astro.props;
---
<div class="slideshow" data-slideshow>
  <div class="slideshow__track" id={id} tabindex="0" aria-label="Photo slideshow" role="region">
    {images.map((img, i) => (
      <div class="slideshow__slide">
        <Image src={img.src} alt={img.alt} width={900} loading={i === 0 ? 'eager' : 'lazy'} />
      </div>
    ))}
  </div>
  <div class="slideshow__dots" aria-hidden="true">
    {images.map((_, i) => <button type="button" tabindex="-1" class:list={['dot', { active: i === 0 }]} data-i={i}></button>)}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-slideshow]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.slideshow__track')!;
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.dot')];
    const go = (i: number) => track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.i))));
    track.addEventListener('scroll', () => {
      const c = current();
      dots.forEach((d, i) => d.classList.toggle('active', i === c));
    }, { passive: true });
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let paused = false;
      root.addEventListener('mouseenter', () => (paused = true));
      root.addEventListener('mouseleave', () => (paused = false));
      root.addEventListener('focusin', () => (paused = true));
      setInterval(() => { if (!paused) go((current() + 1) % dots.length); }, 5000);
    }
  });
</script>

<style>
  .slideshow { position: relative; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); border: 1px solid var(--line); }
  .slideshow__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; aspect-ratio: 4 / 3; }
  .slideshow__track::-webkit-scrollbar { display: none; }
  .slideshow__slide { flex: 0 0 100%; scroll-snap-align: start; }
  .slideshow__slide :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .slideshow__dots { position: absolute; bottom: 14px; left: 0; right: 0; display: flex; justify-content: center; gap: 8px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; border: 0; padding: 0; background: rgba(255,255,255,0.5); cursor: pointer; }
  .dot.active { background: var(--gold-light); transform: scale(1.2); }
</style>
