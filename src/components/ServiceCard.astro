---
import { Image } from 'astro:assets';
import type { Service } from '../data/services';
import { url } from '../lib/url';
interface Props { service: Service }
const { service } = Astro.props;
---
<a class="card" href={url(`/services/${service.slug}/`)}>
  <Image src={service.image} alt={service.imageAlt} width={700} class="card__img" loading="lazy" />
  <div class="card__overlay">
    <h3 class="card__title">{service.title}</h3>
    <p class="card__text">{service.short}</p>
    <span class="card__more">Learn more →</span>
  </div>
</a>

<style>
  .card {
    position: relative; display: block; overflow: hidden; border-radius: var(--radius);
    min-height: 440px; text-decoration: none; color: var(--white); box-shadow: var(--shadow);
    border: 1px solid var(--line);
  }
  .card__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .card__overlay {
    position: relative; z-index: 1; height: 100%; min-height: 440px;
    display: flex; flex-direction: column; justify-content: flex-end; align-items: center; text-align: center;
    padding: 28px 24px 32px;
    background: linear-gradient(180deg, rgba(5,11,28,0.15) 0%, rgba(5,11,28,0.75) 50%, rgba(5,11,28,0.95) 100%);
  }
  .card__title { text-transform: uppercase; font-size: clamp(1.3rem, 2.4vw, 1.7rem); }
  .card__text { color: var(--text); margin-bottom: 18px; }
  .card__more { color: var(--gold-light); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.95rem; }
  .card:hover .card__img { transform: scale(1.05); }
  .card:hover .card__more { color: var(--white); }
</style>
